# All credentials and identifiers below are synthetic, disposable, and local-only.
# Never use these sample credentials for a deployed service.
# Application connection URL; keep aligned with the Compose credentials and port.
DATABASE_URL=postgresql://synthetic_demo:synthetic_local_only@127.0.0.1:5433/synthetic_demo
# Optional application connection timeout in seconds (1-30, default 5).
DATABASE_CONNECT_TIMEOUT=5
# Compose database identity and credentials (required by Compose).
POSTGRES_USER=synthetic_demo
POSTGRES_PASSWORD=synthetic_local_only
POSTGRES_DB=synthetic_demo
# Optional published loopback port (default 5433).
POSTGRES_PORT=5433
# Optional Compose project namespace; use a distinct name for isolated checks.
COMPOSE_PROJECT_NAME=rag-audit-demo
STUB_SIGNING_KEY=synthetic-disposable-signing-key-000000
ANSWER_MODE=extractive
QUESTION_CHARACTERS=4000
HTTP_BODY_BYTES=16384
EVIDENCE_BYTES=12288
PROMPT_BYTES=32768
CONTEXT_CHUNKS=5
OUTPUT_UNITS=512
OUTPUT_BYTES=16384
MAX_STATEMENTS=5
STATEMENT_CHARACTERS=2048
PROVIDER_SECONDS=10
COST_CEILING=0.01
GENERATION_BACKEND=fake
GENERATION_REASONING_EFFORT=medium
GENERATION_OUTPUT_TOKENS=2048
GENERATION_SECONDS=60
GENERATION_COST_CEILING=0.55
# Real integration requires operator configuration; never put the actual key here.
# GENERATION_BASE_URL=https://your-endpoint.example/v1
# GENERATION_MODEL=your-requested-model
# GENERATION_REPORTED_MODEL=your-exact-reported-model
# GENERATION_KEY_ENV=YOUR_PROVIDER_KEY
# GENERATION_PRICE_VERSION=your-dated-price-table
# GENERATION_PRICE_SOURCE=Operator-supplied list estimate; not verified billing
# GENERATION_INPUT_PRICE=<USD-per-million-input-tokens>
# GENERATION_CACHED_PRICE=<USD-per-million-cached-read-tokens>
# GENERATION_WRITE_PRICE=<USD-per-million-cache-write-tokens>
# GENERATION_OUTPUT_PRICE=<USD-per-million-output-tokens>
